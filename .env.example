# Supabase → Project Settings → Database → Connection string → Session pooler (URI).
# Tiene que ser el de sesión, puerto 5432. El de transacción (6543) no vale: Payload usa prepared statements.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=cambia-esto-por-un-secreto-largo
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@ceslarioja.org
SEED_ADMIN_PASSWORD=cambia-esta-contraseña
# Opcional. Autoriza a un cron a ejecutar la publicación programada: Authorization: Bearer <valor>
CRON_SECRET=
